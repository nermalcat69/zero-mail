# ─── Gmail SMTP Credentials ───────────────────────────────────────────────────
# The Gmail address you are warming up (used as SMTP login + From address)
GMAIL_USER=your@gmail.com

# Gmail App Password (NOT your account password)
# Generate at: https://myaccount.google.com/apppasswords
# Format: xxxx xxxx xxxx xxxx  (16 chars, spaces optional)
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ─── Turso Database Credentials ───────────────────────────────────────────────
# Get URL:   turso db show gmail-warmup --url
TURSO_DATABASE_URL=libsql://your-db.turso.io

# Get token: turso db tokens create gmail-warmup
TURSO_AUTH_TOKEN=your-turso-auth-token
